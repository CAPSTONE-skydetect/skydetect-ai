# Relative paths are resolved from skydetect-ai/docker.
PI_RELAY_RUNTIME=../../.skydetect-pi
PI_CAMERA_SSH=camera-user@raspberrypi.local
# Set these to id -u and id -g for direct Docker Compose invocations.
# control.py supplies the invoking user's values when omitted.
# PI_LOCAL_UID=1000
# PI_LOCAL_GID=1000
# FFmpeg defaults to PATH; MediaMTX defaults to PI_RELAY_RUNTIME/bin/mediamtx.
# PI_FFMPEG=/path/to/ffmpeg
# PI_MEDIAMTX=/path/to/mediamtx
PI_FRONTEND_ORIGIN=http://127.0.0.1:5178

# Keep the local integration listeners off the LAN.
FRONTEND_HOST_PORT=127.0.0.1:5178
BACKEND_HOST_PORT=127.0.0.1:18080
AI_RF_HOST_PORT=127.0.0.1:18000
AI_MINIROCKET_HOST_PORT=127.0.0.1:18001
MYSQL_HOST_PORT=127.0.0.1:13307
