# 이 파일을 .env 로 복사해서 값을 채운다.  cp .env.example .env

# --- MySQL (컨테이너 전용 DB. 호스트 MySQL 과 별개) ---
DB_USERNAME=skydetect
DB_PASSWORD=여기에_비밀번호
DB_ROOT_PASSWORD=여기에_루트_비밀번호

# --- 최초 운영자 계정 (백엔드 첫 기동 시 생성) ---
OPERATOR_USERNAME=operator
OPERATOR_PASSWORD=여기에_운영자_비밀번호

# --- 프론트 빌드 스위치 (바꾸면 --build 로 다시 빌드해야 반영된다) ---
VITE_CLIP_SOURCE=mock
VITE_ANALYSIS_SOURCE=ai
VITE_HLS_URL=/mock/hls/live.m3u8

# --- 호스트 포트 ---
FRONTEND_HOST_PORT=5173
BACKEND_HOST_PORT=8080
AI_HOST_PORT=8000
MYSQL_HOST_PORT=3307
