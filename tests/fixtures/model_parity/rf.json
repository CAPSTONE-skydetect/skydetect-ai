  "classify_request_schema": {
    "additionalProperties": false,
    "description": "분류 요청 payload를 담는 모델.\n\n한 줄 설명:\n    Spring Boot → FastAPI classifier로 들어오는 입력 형식.\n\n왜 이렇게 했는가:\n    품질 threshold는 상황에 따라 override하고 싶을 수 있어서,\n    기본 feature_vector와 함께 선택적 threshold 파라미터를 받도록 했다.\n\n필드:\n    feature_vector (FeatureVector): B가 만든 특징 패키지\n    min_track_length (int | None): 최소 유효 트랙 길이 override\n    min_mean_conf (float | None): 최소 평균 신뢰도 override\n    max_missing_ratio (float | None): 최대 누락 비율 override",
    "example": {
      "feature_vector": {
        "feature_status": "ok",
        "features": {
          "acceleration_median": 27.89,
          "acceleration_p95": 76.84,
          "curvature_cv": 0.93,
          "heading_change_ratio": 0.19,
          "speed_cv": 0.21,
          "speed_median": 74.67,
          "tortuosity": 1.01,
          "turn_rate_median": 0.25,
          "turn_rate_p95": 0.94
        },
        "imputed_fields": [],
        "quality": {
          "mean_conf": 0.9,
          "missing_ratio": 0.05,
          "num_points": 10,
          "track_stability": "good"
        },
        "track_id": 1
      }
    },
    "properties": {
      "feature_vector": {
        "$ref": "#/components/schemas/FeatureVector"
      },
      "max_missing_ratio": {
        "anyOf": [
          {
            "maximum": 1,
            "minimum": 0,
            "type": "number"
          },
          {
            "type": "null"
          }
        ],
        "description": "최대 허용 누락 비율",
        "title": "Max Missing Ratio"
      },
      "min_mean_conf": {
        "anyOf": [
          {
            "maximum": 1,
            "minimum": 0,
            "type": "number"
          },
          {
            "type": "null"
          }
        ],
        "description": "최소 평균 탐지 신뢰도",
        "title": "Min Mean Conf"
      },
      "min_track_length": {
        "anyOf": [
          {
            "minimum": 1,
            "type": "integer"
          },
          {
            "type": "null"
          }
        ],
        "description": "최소 유효 트랙 길이",
        "title": "Min Track Length"
      }
    },
    "required": [
      "feature_vector"
    ],
    "title": "ClassifyRequest",
    "type": "object"
  },
  "fixtures_sha256": "5ae5362c7c8c53c5a651f8cc9fd9fe96c7f9c435494be7b27ab1aa4e6b8d36b2",
