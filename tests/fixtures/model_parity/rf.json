    "/health"
  ],
  "prediction_schema": {
    "additionalProperties": false,
    "description": "최종 분류 결과를 담는 모델.\n\n한 줄 설명:\n    C가 계산한 label / confidence / 품질 / 설명용 top feature를 함께 반환한다.\n\n왜 이렇게 했는가:\n    단순 label만 반환하면 왜 uncertain이 되었는지, 어떤 품질 상태였는지,\n    어떤 feature가 상대적으로 중요했는지 알기 어렵다.\n    그래서 운영/디버깅/프론트 연동에 필요한 최소 정보를 함께 묶었다.\n\n필드:\n    track_id (int): 대응 track 식별자\n    label (PredictionLabel): bird / drone / uncertain\n    confidence (float): 예측 확률\n    rule_filter (RuleFilterResult): 규칙 기반 필터 결과\n    top_features (dict[str, float]): 상대적 기여도가 큰 feature들 (모델 전체 기준)\n    quality (ResponseQuality): 품질 요약\n    processing_time_ms (int | None): 처리 시간(ms)\n    base_drone_proba (float | None): 이 궤적의 판정 근거 - 트리 루트의 평균 드론 확률\n    feature_contributions (dict[str, float]): 이 궤적의 판정 근거 - 피처별 드론 확률 기여.\n        양수면 드론 쪽, 음수면 새 쪽. base_drone_proba + 합 = 드론 확률.\n        규칙 필터에서 탈락해 모델을 부르지 않았으면 비어 있다.",
    "properties": {
      "base_drone_proba": {
        "anyOf": [
          {
            "maximum": 1,
            "minimum": 0,
            "type": "number"
          },
          {
            "type": "null"
          }
        ],
        "description": "기여 분해의 기준값",
        "title": "Base Drone Proba"
      },
      "confidence": {
        "description": "RF 예측 확률 (uncertain 시 0.0)",
        "maximum": 1,
        "minimum": 0,
        "title": "Confidence",
        "type": "number"
      },
      "feature_contributions": {
        "additionalProperties": {
          "type": "number"
        },
        "description": "피처별 드론 확률 기여 (양수 = 드론 쪽)",
        "title": "Feature Contributions",
        "type": "object"
      },
      "label": {
        "enum": [
          "bird",
          "drone",
          "uncertain"
        ],
        "title": "Label",
        "type": "string"
      },
      "processing_time_ms": {
        "anyOf": [
          {
            "minimum": 0,
            "type": "integer"
          },
          {
            "type": "null"
          }
        ],
        "description": "FastAPI 내부 처리 시간 (ms)",
        "title": "Processing Time Ms"
      },
      "quality": {
        "$ref": "#/components/schemas/ResponseQuality"
      },
      "rule_filter": {
        "$ref": "#/components/schemas/RuleFilterResult"
      },
      "top_features": {
        "additionalProperties": {
          "type": "number"
        },
        "description": "RF 중요도 기반 상위 특징",
        "title": "Top Features",
        "type": "object"
      },
      "track_id": {
        "minimum": 0,
        "title": "Track Id",
        "type": "integer"
      }
    },
    "required": [
      "track_id",
      "label",
      "confidence",
      "rule_filter",
      "quality"
    ],
    "title": "PredictionResult",
    "type": "object"
  }
}
